# docker image for Port Access Control (802.1X / MAB)

DOCKER_PAC_STEM = docker-pac
DOCKER_PAC = $(DOCKER_PAC_STEM).gz
DOCKER_PAC_DBG = $(DOCKER_PAC_STEM)-$(DBG_IMAGE_MARK).gz

$(DOCKER_PAC)_PATH = $(DOCKERS_PATH)/$(DOCKER_PAC_STEM)

$(DOCKER_PAC)_DEPENDS += $(SONIC_PAC) $(HOSTAPD)
$(DOCKER_PAC)_DBG_DEPENDS = $($(DOCKER_SWSS_LAYER_TRIXIE)_DBG_DEPENDS)
$(DOCKER_PAC)_DBG_DEPENDS += $(SONIC_PAC_DBG) $(HOSTAPD_DBG)

$(DOCKER_PAC)_DBG_IMAGE_PACKAGES = $($(DOCKER_SWSS_LAYER_TRIXIE)_DBG_IMAGE_PACKAGES)

$(DOCKER_PAC)_LOAD_DOCKERS += $(DOCKER_SWSS_LAYER_TRIXIE)

SONIC_DOCKER_IMAGES += $(DOCKER_PAC)
SONIC_TRIXIE_DOCKERS += $(DOCKER_PAC)
SONIC_DOCKER_DBG_IMAGES += $(DOCKER_PAC_DBG)
SONIC_TRIXIE_DBG_DOCKERS += $(DOCKER_PAC_DBG)

ifeq ($(INCLUDE_KUBERNETES),y)
$(DOCKER_PAC)_DEFAULT_FEATURE_OWNER = kube
endif

$(DOCKER_PAC)_DEFAULT_FEATURE_STATE_ENABLED = y

ifeq ($(INCLUDE_PAC),y)
ifeq ($(INSTALL_DEBUG_TOOLS),y)
SONIC_PACKAGES_LOCAL += $(DOCKER_PAC_DBG)
else
SONIC_PACKAGES_LOCAL += $(DOCKER_PAC)
endif
endif

$(DOCKER_PAC)_CONTAINER_NAME = pac
$(DOCKER_PAC)_VERSION = 1.0.0
$(DOCKER_PAC)_PACKAGE_NAME = pac
# hostapd and mabd open raw/EAPOL sockets on front-panel netdevs
$(DOCKER_PAC)_CONTAINER_PRIVILEGED = true
$(DOCKER_PAC)_CONTAINER_VOLUMES += /etc/sonic:/etc/sonic:ro
$(DOCKER_PAC)_CONTAINER_VOLUMES += /etc/localtime:/etc/localtime:ro

$(DOCKER_PAC)_SERVICE_REQUIRES = config-setup
$(DOCKER_PAC)_SERVICE_AFTER = swss syncd

$(eval $(call add_dbg_docker,$(DOCKER_PAC),$(DOCKER_PAC_DBG)))
